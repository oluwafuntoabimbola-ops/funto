---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/gloock/400.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/speaking', label: 'Speaking' },
  { href: '/programmes', label: 'Programmes' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const email = 'oluwafuntoabimbola@gmail.com';
const canonical = new URL(path === '/' ? '/' : path, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Oluwafunto Abimbola',
  alternateName: 'Funto Abimbola',
  url: new URL('/', Astro.site).href,
  image: ogImage,
  jobTitle: 'Inclusive education researcher and programme lead',
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'HSE University' },
    { '@type': 'CollegeOrUniversity', name: 'Bowen University' },
  ],
  worksFor: { '@type': 'Organization', name: 'Living Hope Care Society' },
  knowsAbout: ['Inclusive education', 'Education policy', 'Disability rights', 'CRPD Article 24'],
  sameAs: [
    'https://www.linkedin.com/in/abimbola-oluwafunto',
    'https://orcid.org/0000-0001-6459-255X',
    'https://substack.com/@funtoabimbola',
    'https://instagram.com/phdwithfunto',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Oluwafunto Abimbola" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Oluwafunto Abimbola. I help close the gap between inclusion policy and the classroom."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', function () {
        document.documentElement.classList.add('js');
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">Oluwafunto Abimbola</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="menu-word">Menu</span>
        </button>
        <nav class="nav" id="site-nav" aria-label="Main">
          {
            links.map((l) => (
              <a class="nav-link" href={l.href} aria-current={path === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            ))
          }
          <a class="btn ghost" href={`mailto:${email}`}>Email me <span class="arrow" aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-name" aria-hidden="true">Oluwafunto <em>Abimbola</em></p>
        <div class="footer-meta">
          <p>© 2026 Oluwafunto Abimbola · Inclusion policy to practice</p>
          <ul class="footer-links">
            <li>
              <a href="https://www.linkedin.com/in/abimbola-oluwafunto" target="_blank" rel="noopener"
                >LinkedIn <span class="arrow" aria-hidden="true">↗</span></a
              >
            </li>
            <li>
              <a href="https://orcid.org/0000-0001-6459-255X" target="_blank" rel="noopener"
                >ORCID <span class="arrow" aria-hidden="true">↗</span></a
              >
            </li>
            <li>
              <a href="https://substack.com/@funtoabimbola" target="_blank" rel="noopener"
                >Substack <span class="arrow" aria-hidden="true">↗</span></a
              >
            </li>
            <li>
              <a href="https://instagram.com/phdwithfunto" target="_blank" rel="noopener"
                >Instagram <span class="arrow" aria-hidden="true">↗</span></a
              >
            </li>
          </ul>
        </div>
        <p class="small muted" style="margin-top:8px">Red suit photo by Mountain Photography · Graduation gown photo by Island Photography</p>
      </div>
    </footer>
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
