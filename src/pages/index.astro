---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import A from '../components/A.astro';
import Cta from '../components/Cta.astro';
import portrait from '../assets/photos/hse-graduation.jpg';
import cutout from '../assets/photos/portrait-cutout.png';

const email = 'mailto:oluwafuntoabimbola@gmail.com';
const names = [
  'Psychological Science and Education',
  'World of Psychology',
  'International Journal of Humanitarian Action',
  'Journal of Social Policy Studies (accepted)',
  'IPSA World Congress',
  'London International Conference on Inclusive Education',
];
const stops = [
  {
    title: 'The international convention',
    say: 'Article 24 of the UN Convention on the Rights of Persons with Disabilities commits countries to inclusive education.',
  },
  {
    title: 'Nigerian federal policy',
    say: 'Nigeria has written the convention into law. But the law carries no education-specific enforcement.',
  },
  {
    title: 'Osun State implementation',
    say: "My doctoral research follows the commitment here, through the state's own policy.",
  },
  {
    title: 'The school gate',
    say: 'Five schools. 48 adults and 15 learners, interviewed in Yoruba and English with no translator in between.',
  },
  {
    title: 'The classroom',
    say: 'In many schools inclusion stays on paper, and children with disabilities are left at the classroom door.',
  },
];
const sides = [
  {
    href: '/research',
    title: 'Policy research',
    text: 'Doctoral research on how Article 24 of the UN disability convention reaches schools in Osun State, Nigeria. Three published journal articles and one more accepted.',
  },
  {
    href: '/programmes',
    title: 'Programmes',
    text: 'Director of Programmes at Living Hope Care Society, an education and health NGO in Osun State.',
  },
  {
    href: '/speaking',
    title: 'Speaking and teaching',
    text: "Four conference talks since 2024, in Seoul and Moscow, two more papers accepted at conferences in London and Kaohsiung, and master's level teaching at HSE University.",
  },
];
---

<Base
  title="Oluwafunto Abimbola | Inclusive education researcher"
  description="Oluwafunto Abimbola is an inclusive education researcher and programme lead working on why inclusion policy stalls before it reaches the classroom, in Nigeria and beyond."
>
  <section class="hero home">
    <div class="wrap grid">
      <div class="hero-text">
        <p class="pill" data-reveal>Inclusive education researcher and programme lead</p>
        <h1 class="display" data-split>
          I help close the gap between inclusion policy and <em>the classroom.</em>
        </h1>
        <p class="lead" data-reveal>
          Countries sign inclusive education commitments, yet children with disabilities still get left out of
          learning. I am Oluwafunto Abimbola, an inclusive education researcher. I study why that happens in Nigeria
          and other low- and middle-income countries, and I run programmes that put the answers to work.
        </p>
        <div class="btns" data-reveal>
          <A class="btn" href="/research">Read my research</A>
          <A class="btn ghost" href={email}>Email me</A>
        </div>
      </div>
      <div class="hero-stage" data-drag>
        <div class="scene">
          <div class="pop" data-stack>
            <div class="pop-frame" aria-hidden="true"></div>
            <Image
              class="pop-figure"
              src={cutout}
              alt="Oluwafunto Abimbola smiling with her arms folded, a red blazer draped over her shoulders"
              widths={[420, 630, 841]}
              sizes="(max-width: 900px) 300px, 420px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
    <div class="hero-facts">
      <div class="wrap">
        <ul class="facts" data-reveal>
          <li class="fact"><b data-count="5">5</b><span>schools in my Osun State field study</span></li>
          <li class="fact"><b data-count="48">48</b><span>adults and 15 learners interviewed</span></li>
          <li class="fact"><b data-count="3">3</b><span>peer-reviewed journal articles published</span></li>
          <li class="fact"><b data-count="4">4</b><span>conference talks since 2024</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="journey" data-journey>
    <div class="pin">
      <div class="wrap grid">
        <div class="copy">
          <p class="label"><span class="n">01</span> The problem</p>
          <h2 class="h2">Where does inclusion <em>get lost?</em></h2>
          <ol class="stops">
            {
              stops.map((s, i) => (
                <li class="stop">
                  <p class="kicker">Stop {i + 1} of 5</p>
                  <h3>{s.title}</h3>
                  <p class="say">{s.say}</p>
                  {i === 4 && (
                    <p class="pull">
                      That gap is <em>where I work.</em>
                    </p>
                  )}
                </li>
              ))
            }
          </ol>
          <div class="ticks" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>
        <div class="scene-wrap" aria-hidden="true">
          <div class="scene">
            <div class="stack" data-stack>
              <span class="plate"></span><span class="plate"></span><span class="plate"></span><span
                class="plate"></span><span class="plate"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid">
      <div class="head">
        <p class="label" data-reveal><span class="n">02</span> Three sides of the same problem</p>
        <h2 class="h2" data-split>Research, programmes and practice, <em>in one person</em></h2>
        <p class="lead" data-reveal>
          In most teams these three sit with different people. I work across all of them, so findings turn into
          programmes and programmes hold up in real classrooms.
        </p>
      </div>
      <figure class="photo portrait" data-reveal>
        <Image
          src={portrait}
          alt="Oluwafunto Abimbola in a graduation gown and cap, smiling and holding a blue diploma folder outside the Higher School of Economics in Moscow"
          widths={[380, 570, 760, 960]}
          sizes="(max-width: 900px) 380px, 400px"
        />
      </figure>
      <div class="bigrows" data-stagger>
        {
          sides.map((s, i) => (
            <a class="bigrow" href={s.href} data-reveal>
              <span class="num">0{i + 1}</span>
              <h3>{s.title}</h3>
              <span class="go" aria-hidden="true">
                ↗
              </span>
              <p>{s.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section same">
    <div class="wrap">
      <p class="label" data-reveal style="margin-bottom:28px"><span class="n">03</span> Where the work has appeared</p>
    </div>
    <div class="strip" data-reveal>
      <div class="strip-track">
        <ul>
          {names.map((n) => <li>{n}</li>)}
        </ul>
        <ul aria-hidden="true">
          {names.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Cta
    heading="Working on inclusion?"
    em="Let's talk."
    text="I am open to research partnerships, programme and policy work, and invitations to speak."
  >
    <A class="btn" href={email}>Email me</A>
    <A class="btn ghost" href="https://www.linkedin.com/in/abimbola-oluwafunto">Follow on LinkedIn</A>
    <A class="btn ghost" href="https://substack.com/@funtoabimbola">Subscribe on Substack</A>
  </Cta>
</Base>
