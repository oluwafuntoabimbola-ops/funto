---
import Base from '../layouts/Base.astro';
import A from '../components/A.astro';
---

<Base title="Page not found | Oluwafunto Abimbola" description="This page does not exist.">
  <section class="hero light">
    <div class="wrap grid">
      <div class="hero-text wide">
        <p class="label" data-reveal>404</p>
        <h1 class="display" data-split>Page <em>not found.</em></h1>
        <div class="btns" data-reveal>
          <A class="btn" href="/">Home</A>
          <A class="btn ghost" href="/research">Research</A>
        </div>
      </div>
    </div>
  </section>
</Base>
