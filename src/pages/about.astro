---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import A from '../components/A.astro';
import Cta from '../components/Cta.astro';
import grad from '../assets/photos/hse-graduation.jpg';
import gown from '../assets/photos/graduation-gown.jpg';

const experience = [
  ['January 2026 to present', 'Director of Programmes', 'Living Hope Care Society'],
  ['November 2019 to January 2026', 'Education Program Coordinator', 'Living Hope Care Society'],
  [
    'April to December 2025',
    'Research Assistant',
    'A. A. Pinsky Centre of General and Extracurricular Education, HSE University',
  ],
  ['Fall 2022 and Spring 2023', 'Teaching Assistant', 'Department of Public Policy, HSE University'],
  ['August 2022 to June 2023', 'Research Assistant', 'HSE University'],
  ['July 2022 to July 2023', 'Study Admission Specialist', 'HumanSquad Inc., Toronto (remote)'],
  ['January to August 2021', 'Research Intern', 'University of Ibadan'],
];
const classroom = [
  ['May 2026 to present', 'Early Childhood Educator and ESL Teacher', 'Discovery English Preschool, Moscow'],
  [
    'April 2025 to April 2026',
    'Early Childhood Educator and ESL Teacher (part-time)',
    'Kairos Cultural Centre, Khimki',
  ],
  ['September 2023 to April 2025', 'Early Childhood Educator', 'Akademicheskaya Gimnaziya, Moscow'],
  ['January to April 2023', 'Assistant Teacher', '5 GREEN, Moscow'],
];
const awards = [
  ['2023 to 2026', 'Russian Government Academic Scholarship', 'full doctoral funding'],
  ['2021 to 2023', 'Pa. Awomolo Excellence Award', "fully funded master's scholarship"],
  ['2019', 'Excellence Award', 'National Training Academy, Cairo, Egypt'],
  ['2018', 'Student Ambassador of the Year', 'Bowen University'],
  ['2005 to 2018', 'LIHOC Academic Scholarship', 'Living Hope Care Society'],
];
---

<Base
  title="About Oluwafunto Abimbola | Education policy researcher"
  description="About Oluwafunto Abimbola: education policy researcher at HSE University, Director of Programmes at Living Hope Care Society, and a former scholarship student of the programme she now leads."
>
  <section class="hero">
    <div class="wrap grid">
      <div class="hero-text seven">
        <p class="label" data-reveal>About</p>
        <h1 class="h1-page" data-split>About <em>Oluwafunto Abimbola</em></h1>
        <p class="lead" data-reveal>
          I am an education policy researcher and programme lead. Most people call me Funto. I am Yoruba, from
          Nigeria, and I have lived in Moscow since 2021.
        </p>
      </div>
      <div class="collage" data-reveal>
        <figure class="photo p1">
          <Image
            src={grad}
            alt="Oluwafunto Abimbola in a graduation cap and gown, smiling outside the Higher School of Economics in Moscow"
            widths={[330, 500, 660, 960]}
            sizes="(max-width: 900px) 300px, 330px"
            loading="eager"
            style="object-position:50% 22%"
           
          />
        </figure>
        <figure class="photo p2">
          <Image
            src={gown}
            alt="Oluwafunto Abimbola seen from behind in a black graduation gown and cap with a red and silver hood"
            widths={[240, 360, 480, 720]}
            sizes="(max-width: 900px) 200px, 220px"
            loading="eager"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section light">
    <div class="wrap grid">
      <div class="head">
        <p class="label" data-reveal><span class="n">01</span> Why this work is personal</p>
        <h2 class="h2" data-split>Why this work is <em>personal</em></h2>
      </div>
      <div class="body-7 prose" data-reveal>
        <p>
          I have seen education support from both sides. Living Hope Care Society paid for my schooling from 2005 to
          2018. Since January 2026 I have directed its programmes.
        </p>
        <p>
          My doctoral research at HSE University asked why inclusion commitments stall between the law and the
          classroom in Osun State, Nigeria. I ran the fieldwork interviews myself, in Yoruba and English, so nothing
          was lost through a translator.
        </p>
        <p>
          I also teach. Since 2023 I have taught early years classes in Moscow, with children aged 18 months to 7. It
          keeps my research honest about what a classroom is really like.
        </p>
      </div>
    </div>
  </section>

  <section class="section light same">
    <div class="wrap">
      <div class="grid" style="margin-bottom:40px">
        <div class="head">
          <p class="label" data-reveal><span class="n">02</span> Education</p>
          <h2 class="h2" data-split>Education</h2>
        </div>
      </div>
      <div class="ledger" data-stagger>
        <article class="row no-end" data-reveal>
          <p class="when">Started November 2023</p>
          <div class="what">
            <p class="title serif">Doctorate, Education Policy.</p>
            <p class="detail">
              Institute of Education, HSE University, Moscow. Started November 2023. Programme completed October
              2026, final defense ahead. Supervisor: Prof. Sergey Kosaretsky.
            </p>
          </div>
        </article>
        <article class="row no-end" data-reveal>
          <p class="when">2021 to 2023</p>
          <div class="what">
            <p class="title serif">MSc, Political Analysis and Public Policy.</p>
            <p class="detail">
              HSE University, Moscow, 2021 to 2023. Thesis: Analysis of ICT Policy in the Nigerian Education System:
              A Comparative Analysis of Nigeria and Brazil.
            </p>
          </div>
        </article>
        <article class="row no-end" data-reveal>
          <p class="when">2014 to 2018</p>
          <div class="what">
            <p class="title serif">BA, History and International Studies.</p>
            <p class="detail">Bowen University, Iwo, Osun State, Nigeria, 2014 to 2018.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section light same">
    <div class="wrap">
      <div class="grid" style="margin-bottom:40px">
        <div class="head">
          <p class="label" data-reveal><span class="n">03</span> Experience</p>
          <h2 class="h2" data-split>Experience</h2>
        </div>
      </div>
      <div class="ledger" data-stagger>
        {
          experience.map(([when, role, org]) => (
            <article class="row no-end" data-reveal>
              <p class="when">{when}</p>
              <div class="what">
                <p class="title">{role}</p>
                <p class="detail">{org}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section light same">
    <div class="wrap">
      <div class="grid" style="margin-bottom:40px">
        <div class="head">
          <p class="label" data-reveal><span class="n">04</span> In the classroom</p>
          <h2 class="h2" data-split>In the <em>classroom</em></h2>
        </div>
      </div>
      <div class="ledger" data-stagger>
        {
          classroom.map(([when, role, org]) => (
            <article class="row no-end" data-reveal>
              <p class="when">{when}</p>
              <div class="what">
                <p class="title">{role}</p>
                <p class="detail">{org}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p style="margin-top:24px" class="muted" data-reveal>TEFL certified, 2022.</p>
    </div>
  </section>

  <section class="section light same">
    <div class="wrap">
      <div class="grid" style="margin-bottom:40px">
        <div class="head">
          <p class="label" data-reveal><span class="n">05</span> Grants and awards</p>
          <h2 class="h2" data-split>Grants and <em>awards</em></h2>
        </div>
      </div>
      <div class="ledger" data-stagger>
        {
          awards.map(([when, name, detail]) => (
            <article class="row no-end" data-reveal>
              <p class="when">{when}</p>
              <div class="what">
                <p class="title">{name}</p>
                <p class="detail">{detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section light same">
    <div class="wrap grid">
      <div class="head">
        <p class="label" data-reveal><span class="n">06</span> Languages and memberships</p>
        <h2 class="h2" data-split>Languages and <em>memberships</em></h2>
      </div>
      <div class="ledger" style="grid-column:1 / -1" data-stagger>
        <div class="row no-end" data-reveal>
          <p class="when">Languages</p>
          <div class="what">
            <p>Yoruba (native) · English (full professional and academic) · Russian (A2)</p>
          </div>
        </div>
        <div class="row no-end" data-reveal>
          <p class="when">Memberships</p>
          <div class="what">
            <p>
              International Political Science Association · Southern Political Science Association · Young African
              Leaders Initiative
            </p>
          </div>
        </div>
        <div class="row no-end" data-reveal>
          <p class="when">Service</p>
          <div class="what">
            <p>
              Columnist, HSE University (2021 to 2023) · Co-organiser, National Youth Service Corps Sustainable
              Development Goals quality education outreach, Nigeria (2018 to 2019) · Volunteer, HSE Buddy Programme
              for international students (2023 to 2024)
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark cta">
    <div class="wrap">
      <div class="btns" data-reveal>
        <A class="btn" href="/research">Read my research</A>
        <A class="btn ghost" href="mailto:oluwafuntoabimbola@gmail.com">Email me</A>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (max-width: 900px) {
    #about-side {
      grid-column: 1 / -1 !important;
      max-width: 360px;
    }
  }
</style>
