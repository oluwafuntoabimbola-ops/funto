---
interface Props {
  href: string;
  class?: string;
}
const { href, class: cls } = Astro.props;
const external = /^https?:/.test(href);
---

<a href={href} class={cls} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}
  ><slot /> <span class="arrow" aria-hidden="true">↗</span></a
>
